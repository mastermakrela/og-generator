{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "og-generator",
	"account_id": "c605d712b51666faef93b68449cbc470",
	"main": "src/index.ts",
	"compatibility_date": "2024-05-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"placement": {
		"mode": "smart"
	},
	"rules": [
		{
			"type": "Data",
			"globs": ["**/*.ttf"],
			"fallthrough": true
		}
	],
	"r2_buckets": [
		{
			"binding": "FONTS",
			"bucket_name": "fonts"
		}
	]
}
