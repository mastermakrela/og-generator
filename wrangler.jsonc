{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "og-generator",
	"account_id": "c605d712b51666faef93b68449cbc470",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"placement": {
		"mode": "smart"
	},
	"r2_buckets": [
		{
			"binding": "FONTS",
			"bucket_name": "fonts"
		}
	]
}
